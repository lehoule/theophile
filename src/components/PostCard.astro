---
interface Props {
  title: string;
  href: string;
  date: Date;
  excerpt?: string;
  categories?: string[];
  variant?: 'featured' | 'standard' | 'index';
  index?: number;
}
import { categoryHref } from '../data/urls';
const {
  title,
  href,
  date,
  excerpt,
  categories = [],
  variant = 'standard',
  index,
} = Astro.props;
---

<article class:list={['post-card', `post-card--${variant}`]}>
  <div class="post-card-meta">
    {
      index && (
        <span class="post-number" aria-hidden="true">
          {String(index).padStart(2, '0')}
        </span>
      )
    }
    <p class="eyebrow">
      <time datetime={date.toISOString()}
        >{date.toLocaleDateString('fr-CA')}</time
      >
    </p>
  </div>
  <h2><a href={href}><span>{title}</span></a></h2>
  {excerpt && <p>{excerpt}</p>}
  {
    categories.length > 0 && (
      <ul class="tag-list" aria-label="Catégories">
        {categories.slice(0, 4).map((category) => (
          <li>
            <a href={categoryHref(category)}>{category}</a>
          </li>
        ))}
      </ul>
    )
  }
  <a class="post-card-read" href={href} aria-label={`Lire : ${title}`}>
    Lire l’essai <span aria-hidden="true">↗</span>
  </a>
</article>
