---
interface Props {
  postId: string;
  title: string;
}
import { site } from '../data/site';

const { postId, title } = Astro.props;
---

<section
  class="comments"
  data-comments
  data-post-id={postId}
  data-post-title={title}
  aria-labelledby="comments-title"
>
  <h2 id="comments-title">Discussion</h2>
  <div data-comment-list><p class="muted">Chargement des commentaires…</p></div>
  <button class="button secondary" data-load-more hidden>Charger plus</button>
  <form data-comment-form>
    <h3>Ajouter un commentaire</h3>
    <label
      >Nom <input
        name="name"
        required
        minlength="2"
        maxlength="80"
        autocomplete="name"
      /></label
    >
    <label
      >Courriel <span class="muted">(facultatif, non publié)</span><input
        name="email"
        type="email"
        maxlength="254"
        autocomplete="email"
      /></label
    >
    <label
      >Commentaire <textarea
        name="body"
        required
        minlength="2"
        maxlength="5000"
        rows="6"></textarea></label
    >
    <label class="honeypot" aria-hidden="true"
      >Site web <input name="website" tabindex="-1" autocomplete="off" /></label
    >
    <div class="turnstile" data-turnstile data-site-key={site.turnstileSiteKey}>
    </div>
    <button class="button" data-comment-submit type="submit" disabled>
      Envoyer pour modération
    </button>
    <p class="form-status" data-form-status role="status"></p>
  </form>
</section>
<script>
  import { decodeHtmlEntities } from '../data/comment-text';
  import { isBrowserLoopback } from '../data/local-development';

  type CommentItem = {
    id: string;
    parentId: string | null;
    authorName: string;
    body: string;
    createdAt: string;
  };
  const section = document.querySelector('[data-comments]');
  if (section instanceof HTMLElement) {
    const init = async () => {
      const postId = section.dataset.postId;
      const list = section.querySelector('[data-comment-list]');
      const form = section.querySelector('[data-comment-form]');
      const status = section.querySelector('[data-form-status]');
      const submit = section.querySelector('[data-comment-submit]');
      if (
        !postId ||
        !list ||
        !(form instanceof HTMLFormElement) ||
        !(status instanceof HTMLElement) ||
        !(submit instanceof HTMLButtonElement)
      )
        return;
      let turnstileToken = '';
      let turnstileWidgetId = '';
      const localDevelopment = isBrowserLoopback(window.location.hostname);
      const turnstile = section.querySelector('[data-turnstile]');
      const siteKey =
        turnstile instanceof HTMLElement ? turnstile.dataset.siteKey : '';
      const verificationUnavailable = (message: string) => {
        turnstileToken = '';
        submit.disabled = true;
        status.textContent = message;
      };
      if (localDevelopment) {
        if (turnstile instanceof HTMLElement) turnstile.hidden = true;
        submit.disabled = false;
      } else if (turnstile instanceof HTMLElement && siteKey) {
        status.textContent = 'Chargement de la vérification anti-robot…';
        window.onTheophileTurnstileLoad = () => {
          if (!window.turnstile) {
            verificationUnavailable(
              'La vérification anti-robot est indisponible. Rechargez la page et réessayez.',
            );
            return;
          }
          turnstileWidgetId = window.turnstile.render(turnstile, {
            sitekey: siteKey,
            callback: (token) => {
              turnstileToken = token;
              submit.disabled = false;
              status.textContent = '';
            },
            'error-callback': (code) => {
              verificationUnavailable(
                `La vérification anti-robot a échoué (code ${code}). Rechargez la page et réessayez.`,
              );
              return true;
            },
            'expired-callback': () =>
              verificationUnavailable(
                'La vérification anti-robot a expiré. Attendez son renouvellement avant de réessayer.',
              ),
            'timeout-callback': () =>
              verificationUnavailable(
                'La vérification anti-robot a expiré. Rechargez la page et réessayez.',
              ),
          });
        };
        const script = document.createElement('script');
        script.src =
          'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTheophileTurnstileLoad';
        script.async = true;
        script.addEventListener('error', () =>
          verificationUnavailable(
            'La vérification anti-robot n’a pas pu être chargée. Vérifiez que votre navigateur ne la bloque pas, puis rechargez la page.',
          ),
        );
        document.head.appendChild(script);
      } else {
        verificationUnavailable(
          'La vérification anti-robot n’est pas configurée.',
        );
      }
      let cursor = '';
      const entities: Record<string, string> = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      };
      const escapeHtml = (value: string) =>
        decodeHtmlEntities(value).replace(
          /[&<>"']/g,
          (char) => entities[char] || char,
        );
      const linkify = (value: string) =>
        escapeHtml(value)
          .replace(
            /https?:\/\/[^\s<]+/g,
            '<a href="$&" rel="nofollow ugc noopener">$&</a>',
          )
          .replace(/\n/g, '<br>');
      const render = (items: CommentItem[]) => {
        if (!items.length && !cursor) {
          list.innerHTML =
            '<p class="muted">Aucun commentaire pour le moment.</p>';
          return;
        }
        const byParent = new Map<string, CommentItem[]>();
        items.forEach((item) => {
          const key = item.parentId || '';
          byParent.set(key, [...(byParent.get(key) || []), item]);
        });
        const renderBranch = (parentId = '', depth = 0): string =>
          (byParent.get(parentId) || [])
            .map(
              (item: CommentItem) =>
                `<article class="comment" data-comment-id="${item.id}" style="margin-inline-start:${Math.min(depth, 4) * 1.25}rem"><header><strong>${escapeHtml(item.authorName)}</strong><time datetime="${item.createdAt}">${new Date(item.createdAt).toLocaleDateString('fr-CA')}</time></header><p>${linkify(item.body)}</p>${renderBranch(item.id, depth + 1)}</article>`,
            )
            .join('');
        const html = renderBranch();
        list.insertAdjacentHTML('beforeend', html);
      };
      const load = async () => {
        const response = await fetch(
          `/api/comments?postId=${encodeURIComponent(postId)}${cursor ? `&cursor=${encodeURIComponent(cursor)}` : ''}`,
        );
        if (!response.ok) throw new Error('comments');
        const data = (await response.json()) as {
          items: CommentItem[];
          nextCursor?: string | null;
        };
        if (!cursor) list.innerHTML = '';
        render(data.items);
        cursor = data.nextCursor || '';
        const more = section.querySelector('[data-load-more]');
        if (more instanceof HTMLElement) more.hidden = !cursor;
      };
      try {
        await load();
      } catch {
        list.innerHTML =
          '<p class="muted">Les commentaires sont temporairement indisponibles.</p>';
      }
      section
        .querySelector('[data-load-more]')
        ?.addEventListener('click', () => load().catch(() => undefined));
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!localDevelopment && !turnstileToken) {
          verificationUnavailable(
            'Attendez la fin de la vérification anti-robot avant d’envoyer le commentaire.',
          );
          return;
        }
        submit.disabled = true;
        status.textContent = 'Envoi du commentaire…';
        const data: Record<string, string> = {};
        new FormData(form).forEach((value, key) => {
          if (typeof value === 'string') data[key] = value;
        });
        try {
          const response = await fetch('/api/comments', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ ...data, postId, turnstileToken }),
          });
          status.textContent = response.ok
            ? 'Merci. Votre commentaire sera publié après modération.'
            : 'Impossible d’envoyer le commentaire.';
          if (response.ok) form.reset();
          else if (turnstileWidgetId && window.turnstile) {
            window.turnstile.reset(turnstileWidgetId);
          }
        } catch {
          status.textContent =
            'Impossible de joindre le serveur. Vérifiez votre connexion et réessayez.';
        } finally {
          turnstileToken = '';
          submit.disabled = !localDevelopment;
        }
      });
    };
    if ('IntersectionObserver' in window)
      new IntersectionObserver((entries, observer) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          init();
        }
      }).observe(section);
    else init();
  }
</script>
