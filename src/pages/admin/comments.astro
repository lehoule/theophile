---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Modération des commentaires" noindex>
  <section class="hero">
    <p class="eyebrow">Administration</p><h1>Commentaires en attente</h1><p
      class="lede"
    >
      Cette page est protégée par Cloudflare Access en production. En local,
      elle utilise l’authentification de développement.
    </p>
  </section>
  <section class="comments" data-admin-comments>
    <div class="admin-toolbar">
      <button class="button secondary" data-status="pending">En attente</button
      ><button class="button secondary" data-status="approved">Approuvés</button
      ><button class="button secondary" data-status="spam">Indésirables</button>
    </div>
    <div data-admin-list><p class="muted">Chargement…</p></div>
  </section>
</Layout>
<script>
  type AdminItem = {
    id: string;
    author_name: string;
    post_id: string;
    body: string;
    is_admin_reply?: number;
    replies?: AdminItem[];
    post?: { title?: string } | null;
  };
  const root = document.querySelector('[data-admin-comments]');
  if (root instanceof HTMLElement) {
    let status = 'pending';
    const list = root.querySelector('[data-admin-list]');
    const render = (items: AdminItem[]) => {
      if (!list) return;
      const entities: Record<string, string> = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      };
      const escape = (value: unknown) =>
        String(value ?? '').replace(
          /[&<>"']/g,
          (char) => entities[char] || char,
        );
      const renderReplies = (replies: AdminItem[] = []) =>
        replies.length
          ? `<div class="admin-replies">${replies
              .map(
                (reply) =>
                  `<article class="comment" data-id="${escape(reply.id)}" data-admin-reply="${reply.is_admin_reply ? 'true' : 'false'}"><header><strong>${escape(reply.author_name)}</strong><span class="muted">Réponse</span></header><p data-comment-body>${escape(reply.body)}</p>${reply.is_admin_reply ? '<div class="admin-actions"><button class="button secondary" data-action="edit">Modifier</button><button class="button secondary" data-action="delete">Supprimer</button></div>' : ''}</article>`,
              )
              .join('')}</div>`
          : '';
      list.innerHTML = items.length
        ? items
            .map(
              (item) =>
                `<article class="comment" data-id="${escape(item.id)}"><header><strong>${escape(item.author_name)}</strong><span class="muted">${escape(item.post?.title || item.post_id)}</span></header><p data-comment-body>${escape(item.body)}</p><div class="admin-actions"><button class="button" data-action="approved">Approuver</button><button class="button secondary" data-action="spam">Indésirable</button><button class="button secondary" data-action="reply">Répondre</button><button class="button secondary" data-action="delete">Supprimer</button></div>${renderReplies(item.replies)}</article>`,
            )
            .join('')
        : '<p class="muted">Aucun commentaire dans cette liste.</p>';
    };
    const load = async () => {
      if (!list) return;
      const response = await fetch(`/api/admin/comments?status=${status}`);
      if (!response.ok) {
        list.innerHTML = '<p>Accès refusé ou service indisponible.</p>';
        return;
      }
      const data = (await response.json()) as { items: AdminItem[] };
      render(data.items);
    };
    root.querySelectorAll('[data-status]').forEach((button) =>
      button.addEventListener('click', () => {
        status = button.getAttribute('data-status') || 'pending';
        load();
      }),
    );
    root.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement)) return;
      const action = target.dataset.action;
      const article = target.closest('[data-id]');
      if (!action || !article) return;
      const id = article.getAttribute('data-id');
      const currentBody = article.querySelector(
        '[data-comment-body]',
      )?.textContent;
      const body =
        action === 'reply'
          ? window.prompt('Réponse')
          : action === 'edit'
            ? window.prompt('Modifier la réponse', currentBody || '')
            : null;
      if ((action === 'reply' || action === 'edit') && !body) return;
      const response =
        action === 'delete'
          ? await fetch(`/api/admin/comments/${id}`, { method: 'DELETE' })
          : action === 'reply'
            ? await fetch(`/api/admin/comments/${id}/replies`, {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ body }),
              })
            : action === 'edit'
              ? await fetch(`/api/admin/comments/${id}/reply`, {
                  method: 'PATCH',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({ body }),
                })
              : await fetch(`/api/admin/comments/${id}`, {
                  method: 'PATCH',
                  headers: { 'content-type': 'application/json' },
                  body: JSON.stringify({ status: action }),
                });
      if (response.ok) load();
    });
    load();
  }
</script>
