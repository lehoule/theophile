---
import { getCollection } from 'astro:content';
import Pagination from '../../../components/Pagination.astro';
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';
import { BLOG_PAGE_SIZE } from '../../../data/pagination';
import { postHref } from '../../../data/urls';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
export async function getStaticPaths() {
  const publishedPosts = (
    await getCollection('posts', ({ data }) => !data.draft)
  ).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
  const count = Math.max(1, Math.ceil(publishedPosts.length / BLOG_PAGE_SIZE));
  return Array.from({ length: count - 1 }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}
const page = Number(Astro.params.page);
const totalPages = Math.max(1, Math.ceil(posts.length / BLOG_PAGE_SIZE));
const pagePosts = posts.slice(
  (page - 1) * BLOG_PAGE_SIZE,
  page * BLOG_PAGE_SIZE,
);
---

<Layout title={`Blog – page ${page}`}>
  <section class="hero"><p class="eyebrow">Archives</p><h1>Blog</h1></section>
  {
    pagePosts.length ? (
      <div class="post-grid">
        {pagePosts.map((post, index) => (
          <PostCard
            title={post.data.title}
            href={postHref(post.data.publishedAt, post.data.slug)}
            date={post.data.publishedAt}
            excerpt={post.data.excerpt}
            categories={post.data.categories}
            image={post.data.featuredMedia}
            index={(page - 1) * BLOG_PAGE_SIZE + index + 1}
          />
        ))}
      </div>
    ) : (
      <p>Cette page n’existe pas.</p>
    )
  }
  <Pagination currentPage={page} totalPages={totalPages} />
</Layout>
