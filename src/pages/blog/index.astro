---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Pagination from '../../components/Pagination.astro';
import PostCard from '../../components/PostCard.astro';
import { BLOG_PAGE_SIZE } from '../../data/pagination';
import { postHref } from '../../data/urls';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const totalPages = Math.max(1, Math.ceil(posts.length / BLOG_PAGE_SIZE));
---

<Layout title="Blog">
  <section class="hero">
    <p class="eyebrow">Théophile</p><h1>Blog</h1><p class="lede">
      Articles d’exégèse, de théologie et de culture chrétienne.
    </p>
  </section>
  {
    posts.length ? (
      <div class="post-grid">
        {posts.slice(0, BLOG_PAGE_SIZE).map((post, index) => (
          <PostCard
            title={post.data.title}
            href={postHref(post.data.publishedAt, post.data.slug)}
            date={post.data.publishedAt}
            excerpt={post.data.excerpt}
            categories={post.data.categories}
            variant={index === 0 ? 'featured' : 'standard'}
            index={index + 1}
          />
        ))}
      </div>
    ) : (
      <p class="muted">Aucun article importé pour le moment.</p>
    )
  }
  <Pagination currentPage={1} totalPages={totalPages} />
</Layout>
