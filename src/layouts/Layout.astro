---
import { site } from '../data/site';
import literataNormalUrl from '@fontsource-variable/literata/files/literata-latin-standard-normal.woff2?url';
import literataItalicUrl from '@fontsource-variable/literata/files/literata-latin-standard-italic.woff2?url';
import literataGreekUrl from '@fontsource-variable/literata/files/literata-greek-standard-normal.woff2?url';
import azeretMonoUrl from '@fontsource-variable/azeret-mono/files/azeret-mono-latin-wght-normal.woff2?url';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  author?: string;
}

const {
  title = site.title,
  description = site.description,
  image,
  noindex = false,
  type = 'website',
  publishedAt,
  updatedAt,
  author = site.author,
} = Astro.props;
const pageTitle = title === site.title ? title : `${title} – ${site.title}`;
const canonical = new URL(Astro.url.pathname, site.origin).toString();
const navigation = [
  { href: '/', label: 'Accueil', index: '01' },
  { href: '/blog/', label: 'Blog', index: '02' },
  { href: '/videos/', label: 'Vidéos', index: '03' },
  { href: '/a-propos/', label: 'À propos', index: '04' },
  { href: '/recherche/', label: 'Recherche', index: '05' },
];
const isCurrent = (href: string) =>
  href === '/'
    ? Astro.url.pathname === href
    : Astro.url.pathname.startsWith(href);
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'BlogPosting' : 'WebSite',
  headline: pageTitle,
  description,
  url: canonical,
  datePublished: publishedAt?.toISOString(),
  dateModified: updatedAt?.toISOString() || publishedAt?.toISOString(),
  author: { '@type': 'Person', name: author },
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="preload"
      href={literataNormalUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={literataItalicUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={literataGreekUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={azeretMonoUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Théophile"
      href="/rss.xml"
    />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {
      image && (
        <meta
          property="og:image"
          content={new URL(image, site.origin).toString()}
        />
      )
    }
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <script is:inline type="application/ld+json" set:html={structuredData} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Aller au contenu</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="Théophile — accueil">
          <span class="brand-mark" aria-hidden="true">
            <span class="brand-symbol">Θ</span>
          </span>
          <span class="brand-name">Théophile</span>
          <span class="brand-note">Carnet de foi<br />et de raison</span>
        </a>
        <nav aria-label="Navigation principale">
          {
            navigation.map((item) => (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                <span aria-hidden="true">{item.index}</span>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main id="main-content" class="shell page-shell"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div class="footer-masthead">
          <span class="footer-mark" aria-hidden="true">Θ</span>
          <div>
            <p class="footer-kicker">Carnet de foi et de raison</p>
            <p class="footer-title">Continuer la réflexion.</p>
            <p class="footer-description">
              Théologie, philosophie et culture au fil des textes.
            </p>
          </div>
        </div>
        <div class="footer-navigation">
          <nav aria-label="Explorer Théophile">
            <p>Explorer</p>
            <a href="/blog/">Tous les articles</a>
            <a href="/videos/">Vidéos</a>
            <a href="/recherche/">Recherche</a>
          </nav>
          <nav aria-label="À propos de Théophile">
            <p>À propos</p>
            <a href="/a-propos/">Le projet</a>
            <a href="/rss.xml">Flux RSS</a>
            <a href="/cookie-policy/">Confidentialité</a>
          </nav>
        </div>
        <div class="footer-colophon">
          <span>Théophile © 2015–{new Date().getFullYear()}</span>
          <a href="#top">Retour en haut <span aria-hidden="true">↑</span></a>
        </div>
      </div>
    </footer>
  </body>
</html>
