{
  "name": "theophile-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "registry": "node scripts/generate-comment-registry.mjs",
    "media:inventory": "node scripts/inventory-media.mjs",
    "build": "npm run registry && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply theophile-comments --local",
    "db:migrate:remote": "wrangler d1 migrations apply theophile-comments --remote",
    "db:export": "wrangler d1 export theophile-comments --remote --output=backups/comments.sql"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.0.0",
    "fast-xml-parser": "^5.2.5",
    "turndown": "^7.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^22.15.30",
    "@types/turndown": "^5.0.6",
    "pagefind": "^1.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "wrangler": "^4.20.0"
  }
}
