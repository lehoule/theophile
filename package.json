{
  "name": "theophile-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "npm run build && wrangler dev",
    "registry": "node scripts/generate-comment-registry.mjs",
    "media:inventory": "node scripts/inventory-media.mjs",
    "media:upload": "node scripts/upload-media-to-r2.mjs",
    "build": "npm run format:check && npm run lint && npm run registry && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && npm run check",
    "format": "prettier --write \"src/**/*.{astro,ts}\" \"worker/**/*.ts\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts}\" \"worker/**/*.ts\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \"*.{js,ts,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply theophile-comments --local",
    "db:import:local": "wrangler d1 execute theophile-comments --local --file=backups/comment-import.sql",
    "db:migrate:remote": "wrangler d1 migrations apply theophile-comments --remote",
    "db:export": "wrangler d1 export theophile-comments --remote --output=backups/comments.sql"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "6.4.8",
    "fast-xml-parser": "5.10.1",
    "turndown": "7.2.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/markdown-remark": "7.2.0",
    "@cloudflare/workers-types": "5.20260724.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@types/turndown": "5.0.6",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "3.0.1",
    "globals": "17.7.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7",
    "wrangler": "4.114.0"
  }
}
